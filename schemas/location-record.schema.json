{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usarockhounding.com/schema/location-record.schema.json",
  "title": "USA Rockhounding Location Record",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "activity",
    "title",
    "status",
    "location",
    "coordinate_policy",
    "materials",
    "access",
    "sources",
    "verification",
    "guide"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "record_id": {
      "type": "string",
      "pattern": "^RH-[A-Z0-9]{8,16}$",
      "description": "Permanent public ID. Never recycle or silently change it."
    },
    "activity": {
      "type": "string",
      "enum": ["rockhounding", "metal_detecting"]
    },
    "title": { "type": "string", "minLength": 3 },
    "status": {
      "type": "string",
      "enum": ["ready", "conditional", "research", "protected"]
    },
    "status_reason": { "type": "string" },
    "location": {
      "type": "object",
      "required": ["country", "region", "locality"],
      "properties": {
        "country": { "type": "string" },
        "region": { "type": "string" },
        "county": { "type": ["string", "null"] },
        "locality": { "type": "string" }
      },
      "additionalProperties": false
    },
    "coordinate_policy": {
      "type": "object",
      "required": ["visibility", "precision_class"],
      "properties": {
        "visibility": {
          "type": "string",
          "enum": ["exact_public", "generalized_public", "withheld"]
        },
        "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "precision_class": {
          "type": "string",
          "enum": ["exact", "entrance", "area_centroid", "locality_context", "withheld"]
        },
        "precision_meters": { "type": ["number", "null"], "minimum": 0 },
        "reason": { "type": ["string", "null"] },
        "sensitive": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "evidence_confidence"],
        "properties": {
          "name": { "type": "string" },
          "evidence_confidence": {
            "type": "string",
            "enum": ["high", "medium", "low", "unknown"]
          },
          "evidence_note": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "geology": {
      "type": "object",
      "properties": {
        "summary": { "type": ["string", "null"] },
        "evidence_confidence": {
          "type": "string",
          "enum": ["high", "medium", "low", "unknown"]
        },
        "formation_or_unit": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "access": {
      "type": "object",
      "required": ["collecting_status", "confidence"],
      "properties": {
        "ownership_class": {
          "type": "string",
          "enum": [
            "federal",
            "state",
            "county",
            "municipal",
            "tribal",
            "private",
            "commercial",
            "mixed",
            "unknown"
          ]
        },
        "manager": { "type": ["string", "null"] },
        "collecting_status": {
          "type": "string",
          "enum": [
            "allowed",
            "allowed_with_conditions",
            "permission_required",
            "fee_site",
            "prohibited",
            "unknown"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low", "unknown"]
        },
        "permission_notes": { "type": ["string", "null"] },
        "seasonal_or_closure_notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "source_type", "title", "checked_at"],
        "properties": {
          "source_id": { "type": "string" },
          "source_type": {
            "type": "string",
            "enum": [
              "land_manager",
              "geological_survey",
              "government_dataset",
              "official_site",
              "historic_reference",
              "community_report",
              "editorial_research",
              "other"
            ]
          },
          "title": { "type": "string" },
          "publisher": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"], "format": "uri" },
          "checked_at": { "type": "string", "format": "date-time" },
          "supports": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "coordinates",
                "geology",
                "material",
                "ownership",
                "access",
                "collecting_rule",
                "closure",
                "history"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "required": ["last_verified_at", "next_review_at"],
      "properties": {
        "last_verified_at": { "type": "string", "format": "date-time" },
        "next_review_at": { "type": ["string", "null"], "format": "date-time" },
        "editorial_confidence": {
          "type": "string",
          "enum": ["high", "medium", "low", "unknown"]
        },
        "needs_review": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "guide": {
      "type": "object",
      "required": ["slug", "publication_state"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "publication_state": {
          "type": "string",
          "enum": ["dynamic", "editorial", "protected_stub"]
        },
        "canonical_url": { "type": ["string", "null"], "format": "uri" }
      },
      "additionalProperties": false
    },
    "near_me": {
      "type": "object",
      "properties": {
        "eligible": { "type": "boolean" },
        "ranking_weight": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "community": {
      "type": "object",
      "properties": {
        "approved_story_count": { "type": "integer", "minimum": 0 },
        "approved_photo_count": { "type": "integer", "minimum": 0 },
        "open_review_flags": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
